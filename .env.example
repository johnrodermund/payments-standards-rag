# Copy to .env (git-ignored). Never commit real keys. Keys are read from the environment only.

# Generation (Claude API). Required for /ask and live evals.
ANTHROPIC_API_KEY=
# Eval judge (TypeSafe JEV). Only needed for `rag_eval --judge jev`.
TYPESAFE_API_KEY=

# Hard cap on total Claude API spend for this project, in USD (ledger: .cache/llm/spend.json)
LLM_BUDGET_USD=0.50
# Set to 1 to replay cached LLM responses only (no network, no cost)
LLM_REPLAY_ONLY=0

# Retrieval confidence cutoff (cosine similarity of the top result)
ESCALATION_MIN_SCORE=0.6
# Set to 1 to keep serving if the audit log cannot be written (default: fail closed with 503)
AUDIT_FAIL_OPEN=0
# Set to 0 to turn off the chunk provenance check
PROVENANCE_CHECK=1

DATABASE_URL=postgresql://payments:payments@localhost:5432/payments
