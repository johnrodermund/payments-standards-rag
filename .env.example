# Copy to .env (git-ignored). Never commit real keys.
AWS_REGION=us-east-1
# Credentials come from the standard AWS chain (AWS_PROFILE, SSO, or the ECS task role in the cloud).
# Only if you must use env keys locally: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
AWS_PROFILE=
BEDROCK_GENERATION_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
JEV_API_KEY=
# Optional, only if the eval judge uses the Claude API instead of Bedrock
ANTHROPIC_API_KEY=
# Set to 1 to replay cached LLM responses only (no network, no cost)
LLM_REPLAY_ONLY=0
