# Copy to .env (git-ignored). Never commit real keys. Keys are read from the environment only.

# Generation (Claude API). Required for /ask and live evals.
ANTHROPIC_API_KEY=
# Eval judge (TypeSafe JEV). Only needed for `rag_eval --judge jev`.
TYPESAFE_API_KEY=

# Hard cap on total Claude API spend for this project, in USD (ledger: .cache/llm/spend.json)
LLM_BUDGET_USD=0.50
# Set to 1 to replay cached LLM responses only (no network, no cost)
LLM_REPLAY_ONLY=0

# Retrieval confidence cutoff (cosine similarity of the top result)
ESCALATION_MIN_SCORE=0.6
# Set to 1 to keep serving if the audit log cannot be written (default: fail closed with 503)
AUDIT_FAIL_OPEN=0
# Set to 0 to turn off the chunk provenance check
PROVENANCE_CHECK=1

# Tracing to Arize Phoenix (off unless the endpoint is set). Local: docker compose up -d phoenix
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=payments-assistant
# Only if Phoenix has authentication on (the default in Phoenix 21+; the local compose file turns it off)
PHOENIX_API_KEY=
# Set to 0 to send ids, scores and timings only (no question, passage or answer text) to the collector
TRACE_CONTENT=1

# POST /ingest is disabled unless this is set (at least 16 random characters). Never commit a real value.
INGEST_API_TOKEN=
# Optional: where the ISO e-Repository zip lives for source="repository" (checked against the pinned sha256)
# INGEST_SOURCE_ZIP=data/raw/iso20022/20260904_ISO20022_2013_eRepository.zip
# Seconds without progress before a stuck ingest job is marked interrupted
INGEST_STALE_SECONDS=1800

DATABASE_URL=postgresql://payments:payments@localhost:5432/payments
